// anti-debug-redirect.js - 检测开发者工具并重定向
(function() {
    'use strict';

    // ========== 配置项 ==========
    const CONFIG = {
        // 基础防护（可选，根据需要开启）
        disableShortcuts: true,        // 是否禁用 F12 / Ctrl+Shift+I 等快捷键
        disableContextMenu: true,      // 是否禁用右键菜单

        // 开发者工具检测
        detectDevTools: false,          // 是否启用检测

        // 检测到后的行为
        warningMessage: '请勿打开开发者工具',   // 提示文字
        redirectUrl: 'https://www.hebeea.edu.cn', // 跳转地址（请替换为实际地址）
        redirectDelay: 2000             // 延迟毫秒数（3秒）
    };

    // ========== 1. 禁用快捷键 ==========
    if (CONFIG.disableShortcuts) {
        document.addEventListener('keydown', function(e) {
            // 兼容 IE 和旧版浏览器
            var key = e.key || String.fromCharCode(e.keyCode || e.which);
            var keyCode = e.keyCode || e.which;

            // F12 (IE 使用 keyCode 122)
            if (key === 'F12' || keyCode === 122) {
                e.preventDefault();
                return false;
            }
            // Ctrl+Shift+I / Ctrl+Shift+J
            if ((e.ctrlKey || e.metaKey) && e.shiftKey &&
                (key === 'I' || key === 'J' || keyCode === 73 || keyCode === 74)) {
                e.preventDefault();
                return false;
            }
            // Ctrl+U (85)
            if ((e.ctrlKey || e.metaKey) && (key === 'u' || keyCode === 85)) {
                e.preventDefault();
                return false;
            }
            // Ctrl+S (83)
            if ((e.ctrlKey || e.metaKey) && (key === 's' || keyCode === 83)) {
                e.preventDefault();
                return false;
            }
        });
    }

    // ========== 2. 禁用右键菜单 ==========
    if (CONFIG.disableContextMenu) {
        document.addEventListener('contextmenu', function(e) {
            e.preventDefault();
            return false;
        });
    }

    // ========== 3. 检测开发者工具 ==========
    if (CONFIG.detectDevTools) {
        let hasTriggered = false;

        // 方法1：检测窗口尺寸变化（开发者工具打开时通常窗口尺寸会变化）
        function detectDevToolsBySize() {
            const threshold = 200;
            const widthDiff = window.outerWidth - window.innerWidth;
            const heightDiff = window.outerHeight - window.innerHeight;

            if (widthDiff > threshold || heightDiff > threshold) {
                onDevToolsOpen();
            }
        }

        // 方法2：检测 console.log 被重写（某些浏览器）
        function detectDevToolsByConsole() {
            const before = console.log;
            console.log = function() {
                before.apply(console, arguments);
                onDevToolsOpen();
            };
        }

        // 方法3：检测 debugger 语句的执行时间
        function detectDevToolsByDebugger() {
            const start = performance.now();
            const end = performance.now();
            const duration = end - start;

            if (duration > 100) {
                onDevToolsOpen();
            }
        }

        // 定时检测
        setInterval(() => {
            detectDevToolsBySize();
            detectDevToolsByDebugger();
        }, 1000);

        function onDevToolsOpen() {
            if (hasTriggered) return;
            hasTriggered = true;

            alert(CONFIG.warningMessage);
            setTimeout(() => {
                window.location.href = CONFIG.redirectUrl;
            }, CONFIG.redirectDelay);
        }
    }
})();